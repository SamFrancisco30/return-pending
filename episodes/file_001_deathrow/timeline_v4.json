  //  COLE 0.7 m  //  KNOX 1.3 m"},{"from":85.01666666666667,"to":89.26666666666667,"text":"POSITION EXCHANGE  //  COLE <-> UNK-01  //  UNK-01 IN CELL"},{"from":108.6,"to":112,"text":"PULSE CONTAINED  //  DOOR SEALED  //  NO EXCHANGE"},{"from":110.8,"to":122.8,"text":"RECOVERING TEAM 04  //  TWO INSIDE  //  DOOR OPEN"}],"subtitles":[{"from":4.4,"to":8.6,"who":"DISPATCH","text":"There it is again. It has never come through that door."},{"from":15.1,"to":18.2,"who":"KNOX","text":"Cole, confirm him. Miller, stay on Cole. Nobody else moves."},{"from":27.3,"to":28.5,"who":"MILLER","text":"CONTACT!"},{"from":29,"to":30.4,"who":"MILLER","text":"Fuse, just blow him!"},{"from":30.6,"to":33.2,"who":"FUSE","text":"With our man on the floor right there? No."},{"from":33.9,"to":35.9,"who":"KNOX","text":"He's solid. It barely moves him."},{"from":39.4,"to":40.9,"who":"REYES","text":"His hand. He's counting."},{"from":41.1,"to":43.4,"who":"DISPATCH","text":"...Twenty seconds. He's on the signal."},{"from":43.5,"to":44.4,"who":"KNOX","text":"Miller!"},{"from":47.80672316282746,"to":50.50672316282746,"who":"REYES","text":"He ran at Miller. He was waiting for you."},{"from":51,"to":53.6,"who":"REYES","text":"It takes whoever's closest. Like the count."},{"from":54,"to":56.2,"who":"KNOX","text":"Everyone out. I walk out last."},{"from":59,"to":60.6,"who":"DISPATCH","text":"Next pulse in five."},{"from":68.23333333333332,"to":69.03333333333332,"who":"FUSE","text":"Door holds."},{"from":69.23333333333332,"to":71.03333333333332,"who":"REYES","text":"...Knox is still in there."},{"from":73.4,"to":75.2,"who":"REYES","text":"Knox, he's not hitting you."},{"from":75.5,"to":77.6,"who":"KNOX","text":"He needs me closer than Cole."},{"from":77.9,"to":80.6,"who":"KNOX","text":"Cole. On my word, come to the bars."},{"from":79,"to":81.5,"who":"DISPATCH","text":"Pulse in five. Knox, point eight. Cole, four."},{"from":81.6,"to":82.4,"who":"KNOX","text":"Now."},{"from":85.76666666666667,"to":86.96666666666667,"who":"KNOX","text":"Door!"},{"from":96.6,"to":99.2,"who":"COLE","text":"Knox. Miller's gone."},{"from":105,"to":107.6,"who":"REYES","text":"Wait for it to hit the door."},{"from":109.7,"to":112.4,"who":"KNOX","text":"Fuse, with me. We carry him out."},{"from":122.8,"to":123.8,"who":"KNOX","text":"Shut it."}],"samples":{"step":"../audio/sfx/step_a.wav","step_heavy":"../audio/sfx/step_b.wav","step_light":"../audio/sfx/step_a.wav","gunfire":"../audio/sfx/f01/gunfire_burst.wav","hit":"../audio/sfx/hit.wav","relocate":"../audio/sfx/relocate.wav","glitch":"../audio/sfx/f01/glitch_burst.wav","door_slam":"../audio/sfx/f01/door_slam.wav","door_latch":"../audio/sfx/f01/door_latch.wav","thump":"../audio/sfx/f01/door_thump.wav","shotgun":"../audio/sfx/f001/shotgun.wav","rifle":"../audio/sfx/f001/rifle.wav","sniper":"../audio/sfx/f001/sniper.wav","pistol_s":"../audio/sfx/f001/pistol_s.wav","mg_shot":"../audio/sfx/f001/mg_shot.wav","mg_tail":"../audio/sfx/f001/mg_tail.wav","blast_a":"../audio/sfx/f001/blast_a.wav","blast_b":"../audio/sfx/f001/blast_b.wav","blast_c":"../audio/sfx/f001/blast_c.wav","pistol":"../audio/sfx/f001/pistol.wav","crossbow":"../audio/sfx/f001/crossbow.wav","axe":"../audio/sfx/f001/axe.wav","shield_hit":"../audio/sfx/f001/shield_hit.wav","punch":"../audio/sfx/f001/punch.wav","door_pound":"../audio/sfx/f001/door_pound.wav","pulse":"../audio/sfx/f001/pulse.wav","door_open":"../audio/sfx/fire_door.wav","stamp":"../audio/sfx/f01/stamp.wav","beacon_chirp":"../audio/sfx/f01/beacon_chirp.wav","pack_drag":"../audio/sfx/f01/pack_drag.wav"},"sfx":[{"type":"ambience","kind":"garage"},{"type":"oneshot","t":27.5,"sample":"rifle","vary":50,"pan":0.03671874999999991},{"type":"oneshot","t":27.625,"sample":"rifle","vary":50,"pan":0.03671874999999991},{"type":"oneshot","t":27.75,"sample":"rifle","vary":50,"pan":0.035379464285714146},{"type":"oneshot","t":28.400000000000002,"sample":"rifle","vary":50,"pan":0.01796875000000009},{"type":"oneshot","t":28.52500000000000