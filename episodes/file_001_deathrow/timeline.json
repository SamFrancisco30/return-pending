024,576,1.05],[61.5,1024,576,1.05],[63.7,1132,576,1.6],[64.46666666666667,1132,576,2.05],[66.26666666666667,1112.8,576,1.75],[71,812,576,1.35],[79.5,402.4,576,1.6],[84.3,402.4,576,1.6],[86.2,1024,576,1.05],[88.77222222222221,1024,576,1.05],[89.22222222222221,1784.8,576,1.9],[89.47222222222221,1784.8,576,1.9],[89.64222222222222,376.8,576,1.75],[92.1222222222222,376.8,576,1.75],[94.52222222222221,1024,576,1.05],[112,1024,576,1.08]],"warn":[{"from":27.05,"to":30,"text":"POSITION EXCHANGE  //  COLE <-> UNK-01"},{"from":45.13888888888889,"to":48.088888888888896,"text":"POSITION EXCHANGE  //  KNOX <-> UNK-01"},{"from":56.6,"to":63.6,"text":"HYPOTHESIS: PULSE TRADES UNK-01 WITH NEAREST PERSON IN BLOCK"},{"from":65.11666666666666,"to":68.06666666666666,"text":"POSITION EXCHANGE  //  KNOX <-> UNK-01"},{"from":79.8,"to":83.6,"text":"UNK-01 HELD AT BOUNDARY  //  CANNOT CROSS"},{"from":84.6,"to":88.92222222222222,"text":"PULSE  //  NO PERSON IN HALL  //  STILL SPREADING"},{"from":89.77222222222221,"to":94.02222222222221,"text":"POSITION EXCHANGE  //  COLE <-> UNK-01  //  UNK-01 IN CELL"},{"from":108,"to":112,"text":"PULSE  //  NO PERSON IN BLOCK  //  NO EXCHANGE"}],"subtitles":[{"from":0.6,"to":3.6,"who":"KNOX","text":"Team Four's beacon is in there. Hold at the door."},{"from":4.4,"to":8.4,"who":"DISPATCH","text":"There it is again. Every twenty seconds. Watch: it stops at your door."},{"from":9.6,"to":11.6,"who":"REYES","text":"One body. Twelve meters in."},{"from":12,"to":14.2,"who":"KNOX","text":"And something in the end cell. Locked in."},{"from":14.5,"to":17.8,"who":"KNOX","text":"Cole, confirm him. Miller, stay on Cole. Nobody else moves."},{"from":22,"to":23.9,"who":"COLE","text":"It's Team Four. No pulse."},{"from":27.3,"to":28.5,"who":"MILLER","text":"CONTACT!"},{"from":28.8,"to":30.8,"who":"KNOX","text":"Behind me! All of you!"},{"from":31.4,"to":33.8,"who":"COLE","text":"I'm in the cell. I'm in ITS cell!"},{"from":34.4,"to":36.6,"who":"HOUND","text":"Two bolts in it. Doesn't care."},{"from":37.4,"to":40,"who":"COLE","text":"Their beacon's in here with me."},{"from":45.488888888888894,"to":46.588888888888896,"who":"REYES","text":"MILLER!"},{"from":46.78888888888889,"to":48.78888888888889,"who":"KNOX","text":"Hound, get him out! It's on me!"},{"from":49,"to":51,"who":"REYES","text":"Dispatch, that signal. When was it?"},{"from":51.1,"to":53.2,"who":"DISPATCH","text":"Just now. And twenty seconds before that."},{"from":53.3,"to":56.4,"who":"REYES","text":"It takes whoever it reaches first. And it stops at that door."},{"from":56.6,"to":59.6,"who":"KNOX","text":"Everyone out. Cole, back wall. Don't move."},{"from":60.4,"to":63.8,"who":"DISPATCH","text":"Pulse in three. Two. One."},{"from":66.06666666666666,"to":68.66666666666666,"who":"DISPATCH","text":"Pulse stopped at the door. Nobody outside was taken."},{"from":71.5,"to":73.5,"who":"REYES","text":"Knox, twelve seconds!"},{"from":80.2,"to":82.2,"who":"KNOX","text":"...It can't cross."},{"from":82.4,"to":84.2,"who":"DISPATCH","text":"Two. One."},{"from":85.6,"to":88.2,"who":"REYES","text":"It's still going. All the way down the hall."},{"from":90.42222222222222,"to":92.42222222222222,"who":"COLE","text":"I'm out. I'm out."},{"from":92.92222222222222,"to":95.1222222222222,"who":"KNOX","text":"Cole. Miller. Now."},{"from":100.6,"to":103.9,"who":"DISPATCH","text":"Pulse in three. Two. One."},{"from":108.4,"to":111.4,"who":"DISPATCH","text":"Nothing in range. It's back in the cell."}]}