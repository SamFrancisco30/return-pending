1024,576,1.06],[100,1024,576,1.06],[108,1024,576,1.1]],"warn":[{"from":24.25,"to":27.2,"text":"POSITION EXCHANGE  //  COLE <-> UNK-01"},{"from":44.25,"to":47.2,"text":"POSITION EXCHANGE  //  KNOX <-> UNK-01"},{"from":56.6,"to":63.6,"text":"HYPOTHESIS: PULSE TRADES UNK-01 WITH NEAREST PERSON IN BLOCK"},{"from":64.25,"to":67.2,"text":"POSITION EXCHANGE  //  KNOX <-> UNK-01"},{"from":78.8,"to":83.6,"text":"UNK-01 HELD AT BOUNDARY  //  CANNOT CROSS"},{"from":84.25,"to":88,"text":"POSITION EXCHANGE  //  COLE <-> UNK-01  //  UNK-01 IN CELL"},{"from":104.3,"to":108,"text":"PULSE  //  NO PERSON IN BLOCK  //  NO EXCHANGE"}],"subtitles":[{"from":0.6,"to":3.6,"who":"KNOX","text":"Team Four's beacon is in there. Hold at the door."},{"from":4.5,"to":7.9,"who":"DISPATCH","text":"There it is again. Every twenty seconds. It never leaves that block."},{"from":8.6,"to":10.8,"who":"REYES","text":"One body. Twelve meters in."},{"from":11.4,"to":13.8,"who":"KNOX","text":"And something in that cell. Locked in."},{"from":14.2,"to":17.6,"who":"KNOX","text":"Cole, confirm him. Miller, stay on Cole. Nobody else moves."},{"from":20.6,"to":23,"who":"COLE","text":"It's Team Four. No pulse."},{"from":24.5,"to":25.7,"who":"MILLER","text":"CONTACT!"},{"from":26.2,"to":28.2,"who":"KNOX","text":"Behind me! All of you!"},{"from":29.8,"to":32.2,"who":"COLE","text":"I'm in the cell. I'm in ITS cell!"},{"from":33.6,"to":35.8,"who":"HOUND","text":"Two bolts in it. Doesn't care."},{"from":37,"to":39.6,"who":"COLE","text":"Their beacon's in here with me."},{"from":44.7,"to":45.9,"who":"REYES","text":"MILLER!"},{"from":46.2,"to":48.2,"who":"KNOX","text":"Hound, get him out! It's on me!"},{"from":48.5,"to":50.5,"who":"REYES","text":"Dispatch, that signal. When was it?"},{"from":50.7,"to":53,"who":"DISPATCH","text":"Just now. And twenty seconds before that."},{"from":53.2,"to":56.4,"who":"REYES","text":"It trades places with whoever's closest. And it stops at that door."},{"from":56.6,"to":59.6,"who":"KNOX","text":"Everyone out. Cole, back wall. Don't move."},{"from":60.4,"to":63.8,"who":"DISPATCH","text":"Pulse in three. Two. One."},{"from":65.4,"to":67.9,"who":"DISPATCH","text":"Pulse stopped at the door. Nobody outside was taken."},{"from":71,"to":73,"who":"REYES","text":"Knox, twelve seconds!"},{"from":79.2,"to":81.2,"who":"KNOX","text":"...It can't cross."},{"from":81.4,"to":83.8,"who":"DISPATCH","text":"Three. Two. One."},{"from":85,"to":87,"who":"COLE","text":"I'm out. I'm out."},{"from":88.4,"to":90.6,"who":"KNOX","text":"Cole. Miller. Now."},{"from":100.6,"to":103.9,"who":"DISPATCH","text":"Pulse in three. Two. One."},{"from":104.9,"to":107.6,"who":"DISPATCH","text":"Nothing in range. It's back in the cell."}]}