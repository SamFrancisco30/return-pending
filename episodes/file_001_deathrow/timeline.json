76,1.9],[89.60888888888888,376.8,576,1.75],[92.08888888888887,376.8,576,1.75],[94.98888888888888,1024,576,1.05],[109.4,1024,576,1.05],[112.4,716,576,1.3],[121.6,460,576,1.45],[124.4,338.4,576,1.6],[126.6,1024,576,1.05],[132,1024,576,1.05]],"warn":[{"from":27.05,"to":30,"text":"POSITION EXCHANGE  //  COLE <-> UNK-01"},{"from":45.205555555555556,"to":48.15555555555556,"text":"POSITION EXCHANGE  //  KNOX <-> UNK-01"},{"from":56.6,"to":63.6,"text":"HYPOTHESIS: PULSE TRADES UNK-01 WITH NEAREST PERSON IN BLOCK"},{"from":65.20555555555555,"to":68.15555555555555,"text":"POSITION EXCHANGE  //  KNOX <-> UNK-01"},{"from":81.4,"to":83.8,"text":"DOOR SEALED  //  UNK-01 AND COLE INSIDE"},{"from":84.6,"to":88.88888888888889,"text":"PULSE  //  NO PERSON IN HALL  //  STILL SPREADING"},{"from":89.73888888888888,"to":93.98888888888888,"text":"POSITION EXCHANGE  //  COLE <-> UNK-01  //  UNK-01 IN CELL"},{"from":108.6,"to":112,"text":"PULSE CONTAINED  //  DOOR SEALED  //  NO EXCHANGE"},{"from":110.8,"to":122.8,"text":"RECOVERING TEAM 04  //  TWO INSIDE  //  DOOR OPEN"},{"from":128.6,"to":132,"text":"PULSE CONTAINED  //  DOOR SEALED"}],"subtitles":[{"from":0.6,"to":3.6,"who":"KNOX","text":"Team Four's beacon is behind that door. Nobody touches it yet."},{"from":4.4,"to":8.6,"who":"DISPATCH","text":"There it is again. Every twenty seconds. I can't tell you what it is. It has never come through that door."},{"from":8.9,"to":10.1,"who":"KNOX","text":"Open it."},{"from":10.6,"to":12.4,"who":"REYES","text":"One body. Twelve meters in."},{"from":12.7,"to":14.8,"who":"KNOX","text":"And something in the end cell. Locked in."},{"from":15.1,"to":18.2,"who":"KNOX","text":"Cole, confirm him. Miller, stay on Cole. Nobody else moves."},{"from":22.5,"to":24.2,"who":"COLE","text":"It's Team Four. No pulse."},{"from":27.3,"to":28.5,"who":"MILLER","text":"CONTACT!"},{"from":28.8,"to":30.8,"who":"KNOX","text":"Behind me! All of you!"},{"from":31.4,"to":33.8,"who":"COLE","text":"I'm in the cell. I'm in ITS cell!"},{"from":34.4,"to":36.6,"who":"HOUND","text":"Two bolts in it. Doesn't care."},{"from":37.4,"to":40,"who":"COLE","text":"Their beacon's in here with me."},{"from":45.55555555555556,"to":46.65555555555556,"who":"REYES","text":"MILLER!"},{"from":46.855555555555554,"to":48.855555555555554,"who":"KNOX","text":"Hound, get him out! It's on me!"},{"from":49,"to":51,"who":"REYES","text":"Dispatch, that signal. When was it?"},{"from":51.1,"to":53.2,"who":"DISPATCH","text":"Just now. And twenty seconds before that."},{"from":53.3,"to":56.6,"who":"REYES","text":"It takes whoever it reaches first. And it never got out while that door was shut."},{"from":56.8,"to":60,"who":"KNOX","text":"Everyone out. We shut it in with Cole. Cole, back wall, don't move."},{"from":60.4,"to":63.8,"who":"DISPATCH","text":"Pulse in three. Two. One."},{"from":66.15555555555555,"to":68.35555555555555,"who":"DISPATCH","text":"It took Knox again. Closest."},{"from":71.5,"to":73.5,"who":"REYES","text":"Knox, twelve seconds!"},{"from":79.6,"to":80.8,"who":"KNOX","text":"SHUT IT!"},{"from":81.3,"to":82.3,"who":"HOUND","text":"Bolted."},{"from":82.4,"to":84.2,"who":"DISPATCH","text":"Two. One."},{"from":85.4,"to":88.4,"who":"REYES","text":"It hit the door and stopped. It's going the other way. All the way down."},{"from":89.78888888888888,"to":90.98888888888888,"who":"KNOX","text":"Open! Get him out!"},{"from":91.88888888888889,"to":93.28888888888888,"who":"COLE","text":"I'm out. I'm out."},{"from":93.68888888888888,"to":95.68888888888888,"who":"KNOX","text":"Shut it. Cole, Miller. Now."},{"from":96.6,"to":99.2,"who":"COLE","text":"Knox. Miller's gone."},{"from":100.6,"to":103.9,"who":"DISPATCH","text":"Pulse in three. Two. One."},{"from":105,"to":107.6,"who":"REYES","text":"Wait for it. Let it hit the door first."},{"from":108.7,"to":109.6,"who":"DISPATCH","text":"Contained."},{"from":109.7,"to":112.4,"who":"KNOX","text":"One window. Hound, with me. We carry him out."},{"from":115,"to":116.3,"who":"HOUND","text":"Got him. Go."},{"from":118.4,"to":119.8,"who":"REYES","text":"Ten seconds."},{"from":122.8,"to":123.8,"who":"KNOX","text":"Shut it."},{"from":124.3,"to":126.6,"who":"DISPATCH","text":"Pulse is out. Door is shut."},{"from":128.8,"to":131.4,"who":"DISPATCH","text":"Contained. Nothing in range."}],"samples":{"step":"../audio/sfx/step_a.wav","step_heavy":"../audio/sfx/step_b.wav","step_light":"../audio/sfx/step_a.wav","gunfire":"../audio/sfx/f01/gunfire_burst.wav","hit":"../audio/sfx/hit.wav","relocate":"../audio/sfx/relocate.wav","glitch":"../audio/sfx/f01/glitch_burst.wav","door_slam":"../audio/sfx/f01/door_slam.wav","door_latch":"../audio/sfx/f01/door_latch.wav","thump":"../audio/sfx/f01/door_thump.wav","shotgun":"../audio/sfx/f001/shotgun.wav","rifle":"../audio/sfx/f001/rifle.wav","pistol":"../audio/sfx/f001/pistol.wav","crossbow":"../audio/sfx/f001/crossbow.wav","axe":"../audio/sfx/f001/axe.wav","shield_hit":"../audio/sfx/f001/shield_hit.wav","punch":"../audio/sfx/f001/punch.wav","door_pound":"../audio/sfx/f001/door_pound.wav","pulse":"../audio/sfx/f001/pulse.wav","door_open":"../audio/sfx/fire_door.wav","stamp":"../audio/sfx/f01/stamp.wav","beacon_chirp":"../audio/sfx/f01/beacon_chirp.wav","pack_drag":"../audio/sfx/f01/pack_drag.wav"},"sfx":[{"type":"ambience","kind":"garage"},{"type":"oneshot","t":27.35,"sample":"rifle","vary":50,"pan":0.01171875},{"type":"oneshot","t":27.75,"sample":"rifle","vary":50,"pan":0.01171875},{"type":"oneshot","t":28.150000000000002,"sample":"rifle","vary":50,"pan":0.01171875},{"type":"oneshot","t":28.6,"sample":"rifle","vary":50,"pan":0.01171875},{"type":"oneshot","t":31.4,"sample":"rifle","vary":50,"pan":-0.04453125000000002},{"type":"oneshot","t":33.9,"sample":"rifle","vary":50,"pan":-0.04453125000000002},{"type":"oneshot","t":36.4,"sample":"rifle","vary":50,"pan":-0.04453125000000002},{"type":"oneshot","t":38.9,"sample":"rifle","vary":50,"pan":-0.04453125000000002},{"type":"oneshot","t":32.2,"sample":"crossbow","vary